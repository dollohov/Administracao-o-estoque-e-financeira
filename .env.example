# =============================================================================
# CONFIGURAÇÕES DE AMBIENTE - SISTEMA ERP
# =============================================================================
# 
# Este arquivo contém exemplos de variáveis de ambiente necessárias para
# executar o sistema. Copie este arquivo para .env e ajuste os valores.
#
# IMPORTANTE: Nunca commite o arquivo .env com dados reais!
#
# =============================================================================

# =============================================================================
# CONFIGURAÇÕES GERAIS
# =============================================================================

# Modo de debug (True para desenvolvimento, False para produção)
# NUNCA use DEBUG=True em produção!
DEBUG=True

# Chave secreta do Django (gere uma nova para produção)
# Para gerar: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-MUDE-ESTA-CHAVE-EM-PRODUCAO-1234567890

# Hosts permitidos (separados por vírgula)
# Em produção, adicione seu domínio: seudominio.com,www.seudominio.com
ALLOWED_HOSTS=127.0.0.1,localhost

# =============================================================================
# BANCO DE DADOS
# =============================================================================

# URL de conexão com o banco de dados
# SQLite (desenvolvimento):
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (produção):
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco

# MySQL (alternativa):
# DATABASE_URL=mysql://usuario:senha@host:3306/nome_banco

# =============================================================================
# SEGURANÇA (PRODUÇÃO)
# =============================================================================

# Redirecionar HTTP para HTTPS (True em produção)
SECURE_SSL_REDIRECT=False

# Cookies seguros (True em produção com HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# =============================================================================
# ARQUIVOS ESTÁTICOS E MÍDIA
# =============================================================================

# URL base para arquivos estáticos (opcional)
# STATIC_URL=/static/

# URL base para arquivos de mídia (opcional)
# MEDIA_URL=/media/

# =============================================================================
# EMAIL (OPCIONAL)
# =============================================================================

# Configurações de email para notificações
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=sua-senha-de-app

# =============================================================================
# RENDER.COM (PRODUÇÃO)
# =============================================================================

# Para deploy no Render, configure estas variáveis no painel do Render:
#
# DEBUG=False
# SECRET_KEY=<gere-uma-chave-forte>
# ALLOWED_HOSTS=seu-app.onrender.com
# DATABASE_URL=<url-postgresql-fornecida-pelo-render>
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# =============================================================================
# DESENVOLVIMENTO
# =============================================================================

# Timezone (padrão: America/Sao_Paulo)
# TZ=America/Sao_Paulo

# Idioma (padrão: pt-br)
# LANGUAGE_CODE=pt-br
